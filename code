                current_menu = (menu_index==0)?DISP_7:DISP_6;

            else if (current_menu == DISP_4)
                current_menu = DISP_5;

            else if (current_menu == DISP_7) {

    selected_protection = menu_index;   // ⭐ SAVE selection

    current_menu = DISP_8;
    keypad_cursor = input_pos = 0;
    memset(input_buffer,0,sizeof(input_buffer));
}

            else if (current_menu == DISP_8) {

    			char c = keypad_str[keypad_cursor];

    			if (c == 'V') {

    float value = atof(input_buffer);   // ⭐ convert input

    switch(selected_protection)
    {
        case 0:  // OverCurrent
            OC_LIMIT = value;
            break;

        case 1:  // OverVoltage
            OV_LIMIT = value;
            break;

        case 2:  // UnderVoltage
            UV_LIMIT = value;
            break;

        case 3:  // OverFreq
            OFREQ_LIMIT = value;
            break;

        case 4:  // c limit instant
            OC_INST_LIMIT = value;
            break;
    }

    current_menu = DISP_7;
    menu_changed = true;
    lcd_refresh_required = 1;
}

    			else {
        			if (c == '<' && input_pos > 0)
            			input_buffer[--input_pos] = 0;
        			else if (input_pos < 9)
            			input_buffer[input_pos++] = c;

        			lcd_refresh_required = 1;   
        			menu_changed = true;
    			}
			}


            menu_index = 0;
            menu_changed = true;
        }

        vTaskDelay(pdMS_TO_TICKS(50));
    }
}




/* =========================================================
   FFT FUNCTION
========================================================= */
void compute_fft(float *buffer, float *Re, float *Im, float *Mag)
{
    for (int k = 0; k < FFT_N; k++)
    {
        Re[k] = 0;
        Im[k] = 0;

        for (int n = 0; n < FFT_N; n++)
        {
            float angle = 2.0f * PI * k * n / FFT_N;
            Re[k] += buffer[n] * cosf(angle);
            Im[k] -= buffer[n] * sinf(angle);
        }

        Mag[k] = sqrtf(Re[k]*Re[k] + Im[k]*Im[k]);
    }
	
	
    for (int k = 1; k < FFT_N/2; k++){
    	if (k == 1){Mag[k] *= (2.0f / FFT_N);}
        else{Mag[k] *= (2.0f / (FFT_N*10)); }
    }
}

/* =========================================================
   IDMT
========================================================= */
void idmt_protection(float current,float v_rms)
{
    if (current > OC_LIMIT)
    {
        float ratio = current / OC_LIMIT;

        if (ratio > 1.01f)   // avoid divide issue
        {
            trip_delay = (0.14f * TMS_C) / (powf(ratio, 0.02f) - 1.0f);

            if (trip_start_time_oc == 0)
                trip_start_time_oc = esp_timer_get_time(); // µs

            int64_t elapsed_us = esp_timer_get_time() - trip_start_time_oc;

            if (elapsed_us >= (int64_t)(trip_delay * 1e6))
            {
                gpio_set_level(RELAY_GPIO, 1);  // TRIP
                relay_tripped = true;
            }
        }
    }
    
  if (v_rms > OV_LIMIT)
    {
        float ratio = v_rms / OV_LIMIT;

        if (ratio > 1.01f)   // avoid divide issue
        {
            trip_delay = (0.14f * TMS_V) / (powf(ratio, 0.02f) - 1.0f);

            if (trip_start_time_ov == 0)
                trip_start_time_ov = esp_timer_get_time(); // µs

            int64_t elapsed_us = esp_timer_get_time() - trip_start_time_ov;

            if (elapsed_us >= (int64_t)(trip_delay * 1e6))
            {
                gpio_set_level(RELAY_GPIO, 1);  // TRIP
                relay_tripped = true;
            }
        }
    }
    
}

