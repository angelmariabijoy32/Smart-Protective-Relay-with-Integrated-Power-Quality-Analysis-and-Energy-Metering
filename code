/* =========================================================
   TIMER CALLBACK
========================================================= */
static void sampling_timer_cb(void *arg)
{
    if (sample_index >= FFT_N)
    {
        sampling_done = true;
        esp_timer_stop(timer_handle);
        return;
    }

    /* -------- READ VOLTAGE ADC (ZMPT101B) -------- */
    int adc_raw_v;
    adc_oneshot_read(adc_handle, VOLTAGE_ADC_CHANNEL, &adc_raw_v);

    float v_adc = ((float)adc_raw_v / ADC_MAX) * VREF;

    /* Remove DC offset (centered at 1.65V) */
    v_adc = v_adc - DAC_BIAS;

    /* Scale to actual voltage */
    v_buffer[sample_index] = v_adc * VOLTAGE_SCALE;


    /* -------- READ CURRENT ADC (SCT-013) -------- */
    int adc_raw_i;
    adc_oneshot_read(adc_handle, CURRENT_ADC_CHANNEL, &adc_raw_i);

    float i_adc = ((float)adc_raw_i / ADC_MAX) * VREF;

    /* Remove DC offset */
    i_adc = i_adc - C_BIAS ;

    /* Scale to actual current */
    i_buffer[sample_index] = i_adc * CURRENT_SCALE;


    sample_index++;
}
/* =========================================================
   COMPLETE PROCESSING FUNCTION
   (Sampling → FFT → PQ → Protection → Energy)
========================================================= */
void full_processing(void *arg)
{
    while (1)
    {

    /* -------- START SAMPLING -------- */
    sample_index = 0;
    sampling_done = false;

    esp_timer_stop(timer_handle);
	esp_timer_start_periodic(timer_handle, TIMER_US);


    while (!sampling_done)
        vTaskDelay(pdMS_TO_TICKS(1));

    /* -------- DC REMOVAL -------- */
    float mean_v = 0, mean_i = 0;

    for (int i = 0; i < FFT_N; i++)
    {
        mean_v += v_buffer[i];
        mean_i += i_buffer[i];
    }

    mean_v /= FFT_N;
    mean_i /= FFT_N;

    for (int i = 0; i < FFT_N; i++)
    {
        v_buffer[i] -= mean_v;
        i_buffer[i] -= mean_i;
    }

    /* -------- FFT -------- */
    compute_fft(v_buffer, Re_v, Im_v, Mag_v);
    compute_fft(i_buffer, Re_i, Im_i, Mag_i);

    float freq_res = FS / FFT_N;
    
    max = 0.0f;
	k_fund = 1;
     for(int i=0;i<FFT_N/2;i++){
		if(max < Mag_v[i]){
			max = Mag_v[i];
			k_fund = i;
		}
	}

    float fund_freq = k_fund * freq_res;
    freq = fund_freq;

    /* =========================================================
       CURRENT FUNDAMENTAL
    ========================================================= */
    int k_fund_i = 1;
    float max_mag_i = Mag_i[1];

    for (int k = 2; k < FFT_N/2; k++)
    {
        if (Mag_i[k] > max_mag_i)
        {
            max_mag_i = Mag_i[k];
            k_fund_i = k;
        }
    }

    float fund_freq_i = k_fund_i * freq_res;
    freq_i = fund_freq_i;
    
    if (i_rms < 2.0f){i_rms = 0.0f;freq_i  = 0.0f; }

    /* =========================================================
       RMS CALCULATION
    ========================================================= */
v_rms = 0;
i_rms = 0;

for (int i = 0; i < FFT_N; i++)
{
    v_rms += v_buffer[i]*v_buffer[i];
    i_rms += i_buffer[i]*i_buffer[i];
}

v_rms = sqrtf(v_rms/FFT_N);
i_rms = sqrtf(i_rms/FFT_N);
//if (relay_tripped == false){v_rms = v_rms / 1.09f ;}

if (v_rms < 50.0f){ v_rms = 0.0f;}
if (i_rms < 2.0f){ i_rms = 0.0f;}

bool voltage_valid = (v_rms > 50.0f);
bool current_valid = (i_rms > 2.0f);

if (voltage_valid)
{
    instant_protection(i_rms, v_rms, freq);
    idmt_protection(i_rms, v_rms);
}

    /* =========================================================
       THD CALCULATION
    ========================================================= */
    float V1 = Mag_v[k_fund]/sqrtf(2);
    float I1 = Mag_i[k_fund]/sqrtf(2);

    thd_v = 0;
    thd_i = 0;

    for (int h=2; h<=5; h++)
    {
        int kh = h*k_fund;
        if (kh < FFT_N/2)
        {
            thd_v += powf(Mag_v[kh]/sqrtf(2),2);
            thd_i += powf(Mag_i[kh]/sqrtf(2),2);
        }
    }

    thd_v = sqrtf(thd_v)/V1;
    thd_i = sqrtf(thd_i)/I1;
    
    if (i_rms < 2.0f){thd_i = 0.0f;}
    if (v_rms < 50.0f){thd_v = 0.0f;}

    /* =========================================================
       POWER CALCULATIONS
    ========================================================= */
    
    P = 0;

    for (int i=0;i<FFT_N;i++)
        P += v_buffer[i]*i_buffer[i];

    P /= FFT_N;
    
    if (-60.0f < P && P < 60.0f){
		P = 0;
	}

    S = v_rms * i_rms;
    Q = sqrtf(S*S - P*P);
    PF = P/S;

    /* -------- VOLTAGE SAG/SWELL -------- */
if (v_rms < 0.9f * VNOM && v_rms > 0.1f * VNOM)
{
    strcpy(v_sag_status, "SAG");
}
else if (v_rms > 1.1f * VNOM)
{
    strcpy(v_sag_status, "SWELL");
}
else
{
    strcpy(v_sag_status, "NORMAL");
}

/* -------- CURRENT SAG/SWELL -------- */
if (i_rms < 0.9f * INOM && i_rms > 0.1f * INOM)
{
    strcpy(i_sag_status, "SAG");
}
else if (i_rms > 1.1f * INOM)
{
    strcpy(i_sag_status, "SWELL");
}
else
{
    strcpy(i_sag_status, "NORMAL");
}
printf("\n--- SAG/SWELL STATUS ---\n");
printf("Voltage : %s\n", v_sag_status);
printf("Current : %s\n", i_sag_status);

    fund_v = Mag_v[k_fund];
	fund_i = Mag_i[k_fund_i];

/* -------- LOW VOLTAGE CUTOFF -------- */
if (v_rms < 50.0f){freq  = 0.0f; fund_v = 0.0f;   

    P = 0.0f;
    Q = 0.0f;
    S = 0.0f;
    PF = 0.0f;

}

if (i_rms < 1.0f)
{
    freq_i  = 0.0f; 
    fund_i = 0.0f;    

}

    /* =========================================================
       PROTECTION
    ========================================================= */
    printf("\n--- PROTECTION STATUS ---\n");

    if (v_rms > OV_LIMIT) printf("OVER VOLTAGE!\n");
    if (v_rms < UV_LIMIT && v_rms > 50.0f) printf("UNDER VOLTAGE!\n");
    if (i_rms > OC_LIMIT) printf("OVER CURRENT!\n");
    if (freq > OFREQ_LIMIT) printf("OVER FREQUENCY!\n");
    if (freq < UFREQ_LIMIT && freq > 20.0f) printf("UNDER FREQUENCY!\n");

    /* =========================================================
       FFT PRINT
    ========================================================= */
    printf("\n--- FFT SPECTRUM (Voltage & Current) ---\n");
    printf("Bin\tFreq(Hz)\t|V| (Peak)\t|I| (Peak)\n");

    for (int k = 1; k < 8; k++)
    {
        float bin_freq = k * freq_res;

        printf("%2d\t%7.2f\t\t%8.3f\t%8.3f\n",
               k, bin_freq, Mag_v[k], Mag_i[k]);
    }
    
    

    /* =========================================================
       FINAL OUTPUT
    ========================================================= */
    printf("\n--- PQ ANALYSIS ---\n");
    printf("Voltage Frequency : %.2f Hz\n", freq);
    printf("Current Frequency : %.2f Hz\n", freq_i);
    printf("Vrms : %.2f V\n", v_rms);
    printf("Irms : %.2f A\n", i_rms);
    printf("THD V: %.2f %%\n", thd_v*100);
    printf("THD I: %.2f %%\n", thd_i*100);
    printf("Fund V  : %.2f V\n", fund_v/1.414);
    printf("Fund I  : %.2f A\n", fund_i/1.414);
    

    printf("\n--- ENERGY METER ---\n");
    printf("Active Power (P): %.2f W\n", P);
    printf("Apparent Power(S): %.2f VA\n", S);
    printf("Reactive Power(Q): %.2f VAR\n", Q);
    printf("Power Factor     : %.3f\n", PF);
    printf("\n----------------------------------------\n");
    printf("OC_LIMIT    : %.3f\n", OC_LIMIT);
    printf("OV_LIMIT    : %.3f\n", OV_LIMIT);
    
    printf("OC_INST_LIMIT  : %.3f\n", OC_INST_LIMIT);
    printf("\n----------------------------------------\n");

        vTaskDelay(pdMS_TO_TICKS(1000));
    }}



